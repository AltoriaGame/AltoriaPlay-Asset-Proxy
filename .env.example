# Copy this file to .env and replace the example key.
# Do not commit .env or put a permanent server key in a distributed game client.

HOST=127.0.0.1
PORT=3000

# SeaweedFS Filer endpoint reachable from this Node.js process.
SEAWEEDFS_URL=http://127.0.0.1:8888

# Generate a secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
API_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

MAX_UPLOAD_SIZE=2147483648
DEFAULT_BUCKET=retoria-platform-assets-prod

# Browser origins only. Native Godot clients are not restricted by browser CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
